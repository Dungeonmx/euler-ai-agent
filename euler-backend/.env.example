LLM_BASE_URL=http://localhost:8010/v1
LLM_MODEL=local-model
LLM_TEMPERATURE=1
LLM_API_KEY=norequiered
LLM_THINKING_ENABLED=false

# Cómo se envía el system prompt:
#   system     → un mensaje con rol "system" al inicio (Qwen / llama.cpp)
#   first_user → se antepone al primer mensaje del usuario (Gemma no soporta
#                el rol "system" y vLLM exige alternancia estricta)
LLM_SYSTEM_MODE=system
# Cuántos turnos de usuario conservar en el contexto. 0 = sin límite.
LLM_HISTORY_MAX_TURNS=0

TTS_BASE_URL=http://localhost:8019/v1
TTS_VOICE=serena
TTS_SEED=42
TTS_TEMPERATURE=0.8
TTS_RESPONSE_FORMAT=wav

LOG_LEVEL=INFO

# Loguea el JSON completo que recibe el LLM en cada consulta (después del system
# prompt y del historial del checkpointer). Útil para depurar; en producción
# conviene dejarlo apagado porque escribe la conversación completa en el log.
LOG_LLM_PAYLOAD=false

DATABASE_URL="driver://user:pass@localhost/dbname"

# MariaDB — Base de datos pública de la facultad (novedades y carreras)
# El usuario de esta base es de solo lectura (GRANT SELECT).
MARIADB_HOST=localhost
MARIADB_PORT=3306
MARIADB_USER=euler
MARIADB_PASSWORD=secret
MARIADB_DB=euler

# Opcional: URL completa de conexión a la base pública. Si se define, tiene
# prioridad sobre las variables MARIADB_* de arriba.
# CHATBOT_PUBLIC_URL=mysql+pymysql://euler:secret@localhost:3306/chatbot_public?charset=utf8mb4

SYSTEM_PROMPT=""

# Ruta al build del widget que la API sirve en /euler/js. Si se omite, usa
# ../euler-frontend/dist respecto de euler-backend/.
# FRONTEND_DIST_DIR=/ruta/al/dist

# Orígenes desde los que se permite llamar a la API, separados por coma.
# El widget se incrusta en páginas de otros dominios, así que sin esto el
# navegador bloquea el fetch. En producción poné los dominios reales, ej:
# CORS_ORIGINS=https://www.ing.unlpam.edu.ar,https://ing.unlpam.edu.ar
CORS_ORIGINS=*

# Guardas previas al LLM (idioma, código, texto incomprensible y preguntas
# repetidas). Con GUARD_ENABLED=false todo vuelve al comportamiento anterior.
GUARD_ENABLED=true
# Idiomas aceptados. Cualquier otro se rechaza con un aviso bilingüe.
GUARD_ALLOWED_LANGUAGES=es,en
# Los mensajes más cortos que esto (o con menos de 3 palabras) no se evalúan
# por idioma: no hay señal suficiente.
GUARD_LANG_MIN_CHARS=15
GUARD_LANG_MIN_PROB_ACCEPT=0.65
GUARD_LANG_MIN_PROB_REJECT=0.85
# Umbrales de texto incomprensible.
GUARD_SYMBOL_RATIO_MAX=0.5
GUARD_VOWEL_RATIO_MIN=0.15
GUARD_MAX_CONSECUTIVE_CONSONANTS=5
GUARD_MAX_TOKEN_LEN=25
# Reutilizar la respuesta de una pregunta repetida en la misma conversación.
GUARD_REUSE_ANSWER=true
# Reutilizar el audio de esa respuesta si el archivo sigue en disco.
GUARD_REUSE_AUDIO=true
# Generar (y reutilizar) el audio de los avisos de rechazo.
GUARD_CANNED_AUDIO=true
# Tiempo máximo a esperar por el audio de una respuesta sin LLM. Si se agota se
# responde solo con texto (el widget corta a los 50 s).
GUARD_AUDIO_TIMEOUT=25

# Tamaño máximo (en MB) de los archivos que acepta /documentos-conversor/convertir.
DOCUMENT_MAX_MB=20
