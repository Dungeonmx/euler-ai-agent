LLM_BASE_URL=http://localhost:8010/v1
LLM_MODEL=local-model
LLM_TEMPERATURE=1
LLM_API_KEY=norequiered
LLM_THINKING_ENABLED=false

TTS_BASE_URL=http://localhost:8019/v1
TTS_VOICE=serena
TTS_SEED=42
TTS_TEMPERATURE=0.8
TTS_RESPONSE_FORMAT=wav

LOG_LEVEL=INFO

DATABASE_URL="driver://user:pass@localhost/dbname"

# MariaDB — Base de datos pública de la facultad (novedades y carreras)
# El usuario de esta base es de solo lectura (GRANT SELECT).
MARIADB_HOST=localhost
MARIADB_PORT=3306
MARIADB_USER=euler
MARIADB_PASSWORD=secret
MARIADB_DB=euler

# Opcional: URL completa de conexión a la base pública. Si se define, tiene
# prioridad sobre las variables MARIADB_* de arriba.
# CHATBOT_PUBLIC_URL=mysql+pymysql://euler:secret@localhost:3306/chatbot_public?charset=utf8mb4

SYSTEM_PROMPT=""

# Orígenes desde los que se permite llamar a la API, separados por coma.
# El widget se incrusta en páginas de otros dominios, así que sin esto el
# navegador bloquea el fetch. En producción poné los dominios reales, ej:
# CORS_ORIGINS=https://www.ing.unlpam.edu.ar,https://ing.unlpam.edu.ar
CORS_ORIGINS=*
